{% extends 'base.html.twig' %}

{% block title %}{{ award.name }}{% endblock %}

{% block head %}
    <script src="{{ asset('assets/masonry.pkgd.min.js') }}"></script>
{% endblock %}

{% block body %}
    <h1>{{ award.name }}</h1>

    <p>{{ award.description }}</p>

    {{ form_start(form) }}
    <div class="grid">
    {% for category in award.categories %}
        <div class="grid-item {% if category.shouldBeDoubleWidth %}grid-item-double{% endif %}">
            <h4>{{ category.name }}</h4>
            {% for nominee in form['category_' ~ category.id] %}
                <label>
                    {{ form_widget(nominee) }}
                    {{ nominee.vars.label }}
                </label>
            {% endfor %}
        </div>
    {% endfor %}
        <div class="grid-item grid-item-double">
            <h4>Zaznaczyłeś coś nie tak?</h4>
            <p><span class="icon">☞</span> Prawym Przyciskiem Myszy możesz odznaczyć zaznaczoną odpowiedź</p>
            <h4>Masz ochotę na replay?</h4>
            <p class="clicker"><span class="icon">✘</span> kliknij tu dwa razy, żeby odznaczyć wszystkie</p>
        </div>
    </div>

    <div class="voter-signature float-right">
        <p>Oświadczam, że uzupełniłxm<br/><span class="counter" data-max="{{ award.categories|length }}">0</span>/{{ award.categories|length }} kategorii</p>
        {{ form_widget(form.signature_font) }}
        {{ form_widget(form.name) }}
        <label for="{{ form.name.vars.id }}">podpis</label>
    </div>

    <div class="clear"></div>
    <div class="float-right button-container">
        <button class="save-button" type="submit" disabled>Zatwierdź</button>
    </div>

    {{ form_end(form) }}
    <div class="clear"></div>

    <script>
        {
            const el = document.querySelector('#{{ form.signature_font.vars.id }}');
            el.value = getComputedStyle(el).getPropertyValue('font-family').split(',')[0];

            const recount = function() {
                return document.querySelectorAll('.grid-item input[type=radio]:checked').length;
            }

            const counter = document.querySelector('.counter');
            const updateCounter = function() {
                counter.textContent = recount().toString();
                if (counter.textContent === counter.dataset.max) {
                    counter.classList.add('max');
                } else {
                    counter.classList.remove('max');
                }
                checkSaveButton();
            }

            const uncheck = function(ev) {
                ev.preventDefault();
                ev.target.querySelector('input').checked = false;
                updateCounter();
                return false;
            }

            const saveButton = document.querySelector('.save-button');
            const checkSaveButton = function() {
                saveButton.disabled = recount() === 0 || document.querySelector('.voter-signature input[type=text]').value === '';
            }

            document.querySelector('.voter-signature input[type=text]').addEventListener('input', checkSaveButton);

            const labels = document.querySelectorAll('.grid-item label');
            labels.forEach(label => label.addEventListener('contextmenu', uncheck, true));

            const radios = document.querySelectorAll('.grid-item input[type=radio]');
            radios.forEach(input => input.addEventListener('change', function(ev) {
                updateCounter();
            }))

            document.querySelector('.clicker').addEventListener('dblclick', function(ev) {
                radios.forEach(input => input.checked = false);
                updateCounter();
            });
            updateCounter();

            const msnry = new Masonry( '.grid', { "itemSelector": ".grid-item", "columnWidth": 350, "gutter": 20 });
            msnry.layout();
            setTimeout(function() { msnry.layout(); }, 100);
        }
    </script>
{% endblock %}
